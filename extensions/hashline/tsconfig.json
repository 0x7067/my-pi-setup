{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@oh-my-pi/hashline": ["./src/index.ts"],
      "@oh-my-pi/hashline/*": ["./src/*"]
    }
  },
  "include": ["src", "test"]
}
