{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Pi Browser Relay",
  "version": "1.0.0",
  "description": "Connect explicitly selected Chrome tabs to the local Pi browser-relay tool.",
  "permissions": ["debugger", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Pi Browser Relay"
  }
}
