{
  "name": "pi-agent-config",
  "private": true,
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@sting8k/pi-vcc": "0.3.18",
    "@tintinweb/pi-tasks": "0.7.2",
    "acorn": "^8.17.0",
    "jiti": "2.7.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "workspaces": [
    "extensions/*",
    "extensions/hashline"
  ],
  "scripts": {
    "check": "npm run check:root && npm run check --workspaces --if-present",
    "check:root": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write \"extensions/**/*.{ts,cjs,json}\" \"scripts/*.mjs\" \"package.json\" \"settings.json\" \"tsconfig.json\" \"README.md\" \"SETUP.md\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs,json}\" \"scripts/*.mjs\" \"package.json\" \"settings.json\" \"tsconfig.json\" \"README.md\" \"SETUP.md\"",
    "postinstall": "effect-tsgo patch",
    "privacy:harden": "node scripts/harden-private-state.mjs",
    "test": "node --test --experimental-strip-types extensions/shared/*.test.ts extensions/toolbox-lazy/*.test.ts extensions/workflows/*.test.ts && npm run test --workspaces --if-present",
    "test:live": "npm --workspace extensions/subagents run test:live"
  }
}
